# EduOBE AI service configuration
APP_ENV=development
DEBUG=false

# Shared secret with the NestJS API (X-AI-Service-Key header)
SERVICE_API_KEY=change-me-ai-service-key

# LLM (optional - deterministic fallbacks are used when unset)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=20

# Redis / worker
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=eduobe:ai:jobs
WORKER_BATCH_SIZE=10

# NestJS callback webhook (used by the worker)
WEBHOOK_URL=http://localhost:4000/api/v1/ai/webhook

# Service tuning
MAX_TOKENS=2000
TEMPERATURE=0.7
DEFAULT_EMBEDDING_DIMENSIONS=384
