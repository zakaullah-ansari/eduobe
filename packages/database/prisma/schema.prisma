// SYSTEM
// ============================================================================

model AuditLog {
  id         String       @id @default(cuid())
  tenantId   String
  userId     String
  userName   String
  userRole   String
  action     AuditAction
  module     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime     @default(now())
  metadata   Json?
  severity   AuditSeverity @default(info)

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, timestamp])
  @@index([tenantId, module])
  @@index([tenantId, userId])
  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  APPROVE
  REJECT
  CALCULATE
  IMPORT
}

enum AuditSeverity {
  info
  warning
  critical
}

model Notification {
  id               String              @id @default(cuid())
  tenantId         String
  userId           String
  title            String
  message          String
  type             NotificationType
  channel          NotificationChannel
  category         NotificationCategory
  linkedEntityType String?
  linkedEntityId   String?
  linkUrl          String?
  isRead           Boolean             @default(false)
  readAt           DateTime?
  sentAt           DateTime?
  sentVia          String?
  status           NotificationStatus  @default(pending)
  createdAt        DateTime            @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  info
  warning
  success
  error
}

enum NotificationChannel {
  in_app
  email
  sms
}

enum NotificationCategory {
  attendance
  assessment
  feedback
  system
  approval
}

enum NotificationStatus {
  pending
  sent
  failed
  read
}

