enum ConfigStatus {
  draft
  active
  archived
}

model COAttainment {
  id                      String       @id @default(cuid())
  tenantId                String
  courseOfferingId        String
  courseOutcomeId         String
  attainmentConfigId      String
  directAttainmentValue   Decimal      @db.Decimal(4, 2)
  indirectAttainmentValue Decimal?     @db.Decimal(4, 2)
  finalAttainmentValue    Decimal      @db.Decimal(4, 2)
  targetLevel             Decimal      @db.Decimal(3, 2)
  isAttained              Boolean
  assessmentWiseBreakdown Json
  calculatedAt            DateTime     @default(now())
  calculatedBy            String
  version                 Int          @default(1)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  // Relations
  courseOffering   CourseOffering   @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  courseOutcome    CourseOutcome    @relation(fields: [courseOutcomeId], references: [id], onDelete: Cascade)
  attainmentConfig AttainmentConfig @relation(fields: [attainmentConfigId], references: [id])

  @@unique([courseOfferingId, courseOutcomeId, version])
  @@map("co_attainments")
}

model POAttainment {
  id                   String       @id @default(cuid())
  tenantId             String
  programId            String
  programOutcomeId     String
  academicYearId       String
  attainmentConfigId   String
  attainmentValue      Decimal      @db.Decimal(4, 2)
  contributingCOs      Json
  targetLevel          Decimal      @db.Decimal(3, 2)
  isAttained           Boolean
  trend                Json?
  calculatedAt         DateTime     @default(now())
  calculatedBy         String
  version              Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  program          Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  programOutcome   ProgramOutcome   @relation(fields: [programOutcomeId], references: [id], onDelete: Cascade)
  academicYear     AcademicYear     @relation(fields: [academicYearId], references: [id])
  attainmentConfig AttainmentConfig @relation(fields: [attainmentConfigId], references: [id])

  @@unique([programId, programOutcomeId, academicYearId, version])
  @@map("po_attainments")
}

model PSOAttainment {
  id                   String       @id @default(cuid())
  tenantId             String
  programId            String
  psoId                String
  academicYearId       String
  attainmentConfigId   String
  attainmentValue      Decimal      @db.Decimal(4, 2)
  contributingCOs      Json
  targetLevel          Decimal      @db.Decimal(3, 2)
  isAttained           Boolean
  trend                Json?
  calculatedAt         DateTime     @default(now())
  calculatedBy         String
  version              Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Relations
  program                 ProgramSpecificOutcome @relation(fields: [psoId], references: [id], onDelete: Cascade)
  programModel            Program               @relation(fields: [programId], references: [id], onDelete: Cascade)
  academicYear            AcademicYear          @relation(fields: [academicYearId], references: [id])
  attainmentConfig        AttainmentConfig      @relation(fields: [attainmentConfigId], references: [id])

  @@unique([programId, psoId, academicYearId, version])
  @@map("pso_attainments")
}

