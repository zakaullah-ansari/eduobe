model AssessmentType {
  id                    String              @id @default(cuid())
  tenantId              String
  name                  String
  code                  String
  category              AssessmentCategory
  isInternal            Boolean             @default(true)
  defaultMaxMarks       Int                 @default(20)
  applicableCourseTypes Json?
  defaultWeightage      Decimal?            @db.Decimal(5, 2)
  icon                  String?
  color                 String?
  isSystem              Boolean             @default(false)
  status                EntityStatus        @default(active)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assessments Assessment[]

  @@unique([tenantId, code])
  @@map("assessment_types")
}

enum AssessmentCategory {
  formative
  summative
}

model Assessment {
  id                String              @id @default(cuid())
  tenantId          String
  courseOfferingId  String
  assessmentTypeId  String
  name              String
  description       String?
  maxMarks          Int
  weightage         Decimal             @db.Decimal(5, 2)
  passingMarks      Int?
  examDate          DateTime?
  dueDate           DateTime?
  duration          Int?
  coMapping         Json
  bloomMapping      Json?
  instructions      String?
  isPublished       Boolean             @default(false)
  marksEntryStatus  MarksEntryStatus    @default(pending)
  createdBy         String
  approvedBy        String?
  approvedAt        DateTime?
  status            AssessmentStatus    @default(draft)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  courseOffering  CourseOffering  @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  assessmentType  AssessmentType  @relation(fields: [assessmentTypeId], references: [id])
  questionPapers  QuestionPaper[]
  marks           Marks[]

  @@map("assessments")
}

enum MarksEntryStatus {
  pending
  partial
  complete
  locked
}

enum AssessmentStatus {
  draft
  published
  marks_entry
  completed
  locked
}

model QuestionBank {
  id              String          @id @default(cuid())
  tenantId        String
  courseId        String
  questionText    String
  questionType    QuestionType
  options         Json?
  correctAnswer   String?
  marks           Int
  coId            String
  bloomLevel      BloomLevel
  difficultyLevel DifficultyLevel
  expectedTime    Int?
  tags            Json?
  diagramUrl      String?
  solutionText    String?
  createdBy       String
  isVerified      Boolean         @default(false)
  status          EntityStatus    @default(active)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("question_banks")
}

enum QuestionType {
  mcq
  short_answer
  long_answer
  numerical
  descriptive
}

enum DifficultyLevel {
  easy
  medium
  hard
}

model QuestionPaper {
  id                String              @id @default(cuid())
  tenantId          String
  assessmentId      String
  paperTitle        String
  instructions      String?
  totalMarks        Int
  duration          Int
  sections          Json
  bloomDistribution Json?
  coDistribution    Json?
  generatedBy       PaperGenerationMethod @default(manual)
  aiPromptUsed      String?
  approvedBy        String?
  approvedAt        DateTime?
  version           Int                 @default(1)
  status            PaperStatus         @default(draft)
  paperUrl          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  // Relations
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@map("question_papers")
}

enum PaperGenerationMethod {
  manual
  ai
}

enum PaperStatus {
  draft
  approved
  printed
}

model Marks {
  id                 String       @id @default(cuid())
  tenantId           String
  assessmentId       String
  studentId          String
  courseOfferingId   String
  totalMarksObtained Decimal      @db.Decimal(6, 2)
  percentage         Decimal?     @db.Decimal(5, 2)
  coWiseMarks        Json
  questionWiseMarks  Json?
  isAbsent           Boolean      @default(false)
  isExempted         Boolean      @default(false)
  remarks            String?
  enteredBy          String
  enteredAt          DateTime     @default(now())
  modifiedBy         String?
  modifiedAt         DateTime?
  modificationReason String?
  status             MarksStatus  @default(draft)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Relations
  assessment     Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@index([tenantId])
  @@map("marks")
}

enum MarksStatus {
  draft
  submitted
  verified
  locked
}

