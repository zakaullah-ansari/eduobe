  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  // Relations
  courseOffering CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  surveyResponses SurveyResponse[]

  @@map("surveys")
}

enum SurveyType {
  course_exit
  faculty_feedback
  event_feedback
  alumni
  employer
  custom
}

